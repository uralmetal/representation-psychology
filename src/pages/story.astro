---
const base = import.meta.env.BASE_URL;
const target = new URL(base, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${base}`} />
    <link rel="canonical" href={target} />
    <title>История — Репрезентация психологии в кино</title>
  </head>
  <body>
    <p>История переехала на <a href={base}>главную страницу</a>.</p>
  </body>
</html>

---
import Layout from '../../components/Layout.astro';
import MediaFigure from '../../components/MediaFigure.svelte';
import { strings } from '../../lib/i18n';
import { mediaForWork } from '../../lib/media';
import { scenesFile, worksFile } from '../../lib/data';
import type { Work } from '../../lib/types';

export function getStaticPaths() {
  return worksFile().works.map((workItem) => ({ params: { id: workItem.id }, props: { item: workItem } }));
}

const base = import.meta.env.BASE_URL;
const { item: workItem } = Astro.props;
const scenes = scenesFile().scenes.filter((s) => s.work_id === workItem.id);
const media = mediaForWork(workItem.id);
const formatLabel = workItem.format === 'tv_series' ? strings.work.formatSeries : strings.work.formatMovie;
const years = workItem.year_start === workItem.year_end ? String(workItem.year_start) : `${workItem.year_start}–${workItem.year_end}`;
---

<Layout title={workItem.title} description={workItem.description.slice(0, 160)}>
  <p><a href={base} data-back data-base={base}>← {strings.siteTitle}</a></p>
  <script is:inline>
    (() => {
      document.addEventListener('click', (event) => {
        const target = event.target;
        const item = target instanceof Element ? target.closest('[data-return]') : null;
        if (!item) return;
        try { sessionStorage.setItem('rp:return-url', window.location.href); } catch {}
      });
      const link = document.querySelector('[data-back]');
      if (!link) return;
      try {
        const returnUrl = sessionStorage.getItem('rp:return-url');
        if (returnUrl) {
          const parsed = new URL(returnUrl, window.location.origin);
          const base = link.dataset.base ?? '/';
          if (parsed.origin === window.location.origin && parsed.pathname.startsWith(base)) {
            link.setAttribute('href', returnUrl);
            sessionStorage.removeItem('rp:return-url');
            return;
          }
          sessionStorage.removeItem('rp:return-url');
        }
        const anchor = sessionStorage.getItem('rp:last-anchor');
        if (anchor) link.setAttribute('href', `${link.getAttribute('href')}#${anchor}`);
      } catch {}
    })();
  </script>
  <h1>{workItem.title}</h1>
  {workItem.original_title && <p class="muted">{workItem.original_title}</p>}
  <div class="card">
    <dl class="work-meta">
      <div><dt>Формат</dt><dd>{formatLabel}</dd></div>
      <div><dt>{strings.work.years}</dt><dd>{years}</dd></div>
      <div><dt>{strings.work.country}</dt><dd>{workItem.country.join(', ')}</dd></div>
      <div><dt>{strings.work.genres}</dt><dd>{workItem.genres.join(', ')}</dd></div>
    </dl>
    <p>{workItem.description}</p>
  </div>

  {media.length > 0 && (
    <section class="work-media" aria-labelledby="work-media-title">
      <h2 id="work-media-title">Фотографии и визуальные материалы</h2>
      <div class="work-media__grid">
        {media.map((asset) => <MediaFigure asset={asset} {base} workTitle={workItem.title} />)}
      </div>
    </section>
  )}

  <h2>{strings.work.units}</h2>
  <ul>
    {scenes.map((s) => (
      <li>
        <a href={`${base}scene/${s.id}/`} data-return>{s.timecode}</a>
        <span class="muted small"> — {s.description.slice(0, 140)}{s.description.length > 140 ? '…' : ''}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .work-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0 0 1rem; }
  .work-meta dt { font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase; }
  .work-meta dd { margin: 0; }
  .work-media { margin-top: 2rem; }
  .work-media__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
</style>

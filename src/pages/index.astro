---
import Layout from '../components/Layout.astro';
import Progress from '../islands/Progress.svelte';
import SceneDialog from '../islands/SceneDialog.svelte';
import StoryScroll from '../islands/StoryScroll.svelte';
import { strings } from '../lib/i18n';
import { buildSteps } from '../lib/steps';
import { codebookFile, scenesFile, worksFile } from '../lib/data';

const base = import.meta.env.BASE_URL;
const steps = buildSteps();
const works = worksFile().works;
const scenes = scenesFile().scenes;
const entries = codebookFile().entries;
---

<Layout title={strings.siteTitle} description={strings.tagline}>
  <Progress client:idle />
  <SceneDialog client:load {base} />

  <header class="hero">
    <p class="hero__kicker">{strings.tagline}</p>
    <h1>{strings.siteTitle}</h1>
    <p class="lead">{strings.home.thesis}</p>
    <p class="muted hero__cue">{strings.home.scrollCue}</p>
  </header>

  <StoryScroll client:load {steps} {works} {scenes} {entries} {base} />

  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title">{strings.home.ctaTitle}</h2>
    <p class="muted">{strings.home.ctaText}</p>
    <p class="cta__actions">
      <a class="btn" href={`${base}infographics/`}>{strings.nav.infographics}</a>
      <a class="btn" href={`${base}method/#files`}>{strings.home.downloadData}</a>
      <a class="btn btn--ghost" href={`${base}codebook/`}>{strings.nav.codebook}</a>
      <a class="btn btn--ghost" href={`${base}method/`}>{strings.nav.method}</a>
      <a class="btn btn--ghost" href={`${base}#prologue`}>{strings.home.aboutProject}</a>
    </p>
  </section>
</Layout>

<style>
  .hero { margin-bottom: 2.5rem; }
  .hero__kicker {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.4rem;
  }
  .lead { font-size: 1.15rem; max-width: 44rem; }
  .hero__cue { margin-top: 1rem; font-size: 0.9rem; }
  .cta { margin-top: 4rem; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
